# Threeebs :3 Alpha — configuração da instalação
# Copie para .env, substitua todos os valores TROQUE_* e nunca versione o .env.

PROJECT_SLUG=local
TZ=UTC
APP_ENV=production
APP_DEBUG=false

# Política Alpha de bloqueio temporário de login
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=600
LOGIN_LOCK_SECONDS=900
LOGIN_IP_MAX_ATTEMPTS=25

# Recuperação de senha e convite de primeiro acesso
PASSWORD_RESET_COOLDOWN_SECONDS=40
PASSWORD_RESET_TTL_SECONDS=3600
FIRST_ACCESS_TTL_SECONDS=86400

# E-mails transacionais e candidatura de parceiros via n8n
PARTNER_CONFIRMATION_TTL_SECONDS=86400
PARTNER_CONFIRMATION_MAX_PER_HOUR=5
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_TIMEOUT_SECONDS=5

# Habilite somente atrás de proxy confiável/Cloudflare.
TRUST_PROXY_HEADERS=false

# Gere com: openssl rand -hex 32
THREEEBS_SETUP_KEY=TROQUE_A_CHAVE_DE_INSTALACAO

BASE_DOMAIN=localhost
PORTAL_URL=http://localhost:6011
ADMIN_URL=http://localhost:6015
SANDBOX_URL=http://localhost:6016
HOST_URL=http://localhost:6010
PREVIEW_BASE_DOMAIN=localhost
PUBLIC_ROUTE_SCHEME=http

BIND_ADDRESS=127.0.0.1
HOST_PORT=6010
PORTAL_PORT=6011
MYSQL_PORT=6012
PHPMYADMIN_PORT=6013
REDIS_PORT=6014
ADMIN_PORT=6015
SANDBOX_PORT=6016

MYSQL_ROOT_PASSWORD=TROQUE_A_ROOT_SENHA
THREEEBS_ADMIN_DB_USER=threeebs_admin
THREEEBS_ADMIN_DB_PASSWORD=TROQUE_A_ADMIN_SENHA
THREEEBS_PORTAL_DB_USER=threeebs_portal
THREEEBS_PORTAL_DB_PASSWORD=TROQUE_A_PORTAL_SENHA
THREEEBS_SANDBOX_DB_USER=threeebs_sandbox
THREEEBS_SANDBOX_DB_PASSWORD=TROQUE_A_SANDBOX_SENHA
THREEEBS_HOST_DB_USER=threeebs_host
THREEEBS_HOST_DB_PASSWORD=TROQUE_A_HOST_SENHA
THREEEBS_MIGRATOR_DB_USER=threeebs_migrator
THREEEBS_MIGRATOR_DB_PASSWORD=TROQUE_A_MIGRATOR_SENHA

# Fase 3: habilitados somente com o profile runtime-foundation.
# O UUID seleciona um único projeto para os probes de montagem; não use path.
PROJECTS_MYSQL_PORT=6017
PROJECTS_MYSQL_ROOT_PASSWORD=TROQUE_A_ROOT_SENHA_PROJECTS_DB
RUNTIME_PROJECT_UUID=_disabled

# Fase 5: gateway e limites do runtime PHP isolado.
RUNTIME_PROXY_TIMEOUT_SECONDS=15
RUNTIME_PROXY_MAX_BODY_BYTES=8388608
PHP_RUNTIME_MEMORY=256m
PHP_RUNTIME_CPUS=0.50
PHP_RUNTIME_PIDS_LIMIT=64

REDIS_PASSWORD=TROQUE_A_REDIS_SENHA

# Fase 4: tickets WebSocket de uso único e checkpoints via Storage Service.
# Gere o segredo interno com: openssl rand -hex 32
REALTIME_INTERNAL_SECRET=TROQUE_O_SEGREDO_INTERNO_REALTIME
REALTIME_TICKET_TTL_SECONDS=30
REALTIME_CHECKPOINT_DEBOUNCE_MS=2000
REALTIME_CHECKPOINT_MAX_MS=10000
REALTIME_MAX_MESSAGE_BYTES=1048576
PHPMYADMIN_UPLOAD_LIMIT=1G
